{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node build/fix-font-urls.mjs",
    "start": "vite preview --port 3000 --strictPort",
    "opcua": "node opcua/server.mjs",
    "opcua:bridge": "node opcua/bridge.mjs",
    "opcua:test": "node opcua/client-test.mjs",
    "test:motor": "node --test tests/motor.test.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "node-opcua": "^2.175.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
