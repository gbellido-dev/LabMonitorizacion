  {
    "id": "b20f000000000024",
    "type": "function",
    "z": "b20f000000000001",
    "name": "Validar y preparar FC16 40006",
    "func": "const fault = Number(msg.payload);\nif (!Number.isInteger(fault) || fault < 0 || fault > 4) {\n    node.error(\"Código de avería fuera de rango 0…4\", msg);\n    return null;\n}\nmsg.payload = {\n    value: [fault],\n    fc: 16,\n    unitid: 1,\n    address: 5,\n    quantity: 1\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
