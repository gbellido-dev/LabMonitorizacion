  {
    "id": "b20f000000000010",
    "type": "function",
    "z": "b20f000000000001",
    "name": "Decodificar estados",
    "func": "const d = Array.isArray(msg.payload) ? msg.payload : msg.payload?.data;\nif (!Array.isArray(d) || d.length < 5) {\n    node.error(\"Se esperaban 5 discrete inputs\", msg);\n    return null;\n}\n\nmsg.payload = {\n    ready: Boolean(d[0]),\n    running: Boolean(d[1]),\n    alarm: Boolean(d[2]),\n    grid_connected: Boolean(d[3]),\n    wind_ok: Boolean(d[4])\n};\nmsg.topic = \"aerolab/status\";\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
