    {
        "id": "8c228fe10314a1ee",
        "type": "function",
        "z": "ee2aee886c887d90",
        "name": "Comparar con lo esperado",
        "func": "// ENTRADA: la fila plana + msg.prediccion (lo que el modelo espera producir)\n// SALIDA:  la fila con la potencia esperada y la desviación\n\nconst p = msg.payload;\np.potencia_esperada = Math.max(0, Math.round(msg.prediccion.prediccion));\np.desviacion_kw     = Math.round(p.potencia - p.potencia_esperada);\n// rendimiento solo tiene sentido si se espera producir algo\np.rendimiento_pct   = p.potencia_esperada > 200\n    ? Math.round(1000 * p.potencia / p.potencia_esperada) / 10\n    : null;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 570,
        "y": 560,
