    {
        "id": "02fe8abced19ca29",
        "type": "function",
        "z": "ee2aee886c887d90",
        "name": "Campaña de viento",
        "func": "// ENTRADA: un pulso cada 45 s\n// SALIDA:  viento y turbulencia nuevos (HR1 en 0,1 m/s · HR6 en 0,1 %)\n// Así la recogida recorre toda la curva de potencia y no solo el viento de hoy.\n\nconst viento      = 3 + Math.random() * 15;        // 3-18 m/s\nconst turbulencia = 2 + Math.random() * 10;        // 2-12 %\nnode.status({ text: `viento ${viento.toFixed(1)} m/s · turbulencia ${turbulencia.toFixed(0)} %` });\nreturn [[\n    { payload: { value: Math.round(viento * 10),      fc: 6, unitid: 1, address: 1, quantity: 1 } },\n    { payload: { value: Math.round(turbulencia * 10), fc: 6, unitid: 1, address: 6, quantity: 1 } }\n]];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 180,
        "wires": [
            [
                "f245712db4f52d57"
            ]
        ]
    },
    {
        "id": "f245712db4f52d57",
