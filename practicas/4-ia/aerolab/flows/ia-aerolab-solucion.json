    {
        "id": "ea43997e569f75a5",
        "type": "function",
        "z": "ee2aee886c887d90",
        "name": "Decodificar",
        "func": "// ENTRADA: msg.payload = los 16 input registers (enteros de 0 a 65535)\n// SALIDA:  msg.payload = los datos en unidades reales, agrupados por bloque\n\nconst r = msg.payload;\nif (!Array.isArray(r) || r.length < 16) {\n    return null;                      // respuesta incompleta: no seguimos\n}\n\nconst int16  = (v) => v >= 32768 ? v - 65536 : v;  // registros con signo\nconst uint32 = (alta, baja) => alta * 65536 + baja; // datos que ocupan 2 registros\n\nconst ESTADOS = [\"PARADO\", \"ARRANCANDO\", \"EN MARCHA\", \"FRENANDO\", \"AVERÍA\"];\nconst AVERIAS = [\"Sin avería\", \"Sobretemperatura de rodamiento\",\n                 \"Vibración elevada\", \"Pérdida de red\", \"Sobrevelocidad\"];\n\nmsg.payload = {\n    viento: {\n        velocidad_mps: r[0] / 10,\n        direccion_deg: r[5] / 10\n    },\n    rotor: {\n        rpm:           r[1] / 100,\n        pitch_deg:     r[2] / 100,\n        yaw_deg:       r[6] / 10,\n        generador_rpm: r[10]\n    },\n    produccion: {\n        potencia_kw:   uint32(r[3], r[4]),\n        par_nm:        r[11] * 10,\n        energia_kwh:   uint32(r[12], r[13]) / 10\n    },\n    condicion: {\n        vibracion_mms:        r[7] / 100,\n        temp_rodamiento_c:    int16(r[8]) / 10,\n        temp_multiplicador_c: int16(r[9]) / 10\n    },\n    estado: {\n        codigo:        r[14],\n        nombre:        ESTADOS[r[14]] ?? \"DESCONOCIDO\",\n        averia_codigo: r[15],\n        averia:        AVERIAS[r[15]] ?? \"Desconocida\"\n    }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 100,
        "wires": [
            [
                "09538b4262749158"
            ]
        ]
    },
    {
        "id": "09538b4262749158",
        "type": "function",
        "z": "ee2aee886c887d90",
        "name": "Fila plana",
        "func": "// ENTRADA: el mensaje decodificado (bloques viento, rotor, produccion...)\n// SALIDA:  msg.payload = una fila plana: una columna por medida + la etiqueta\n\nconst p = msg.payload;\nmsg.payload = {\n    viento:             p.viento.velocidad_mps,\n    potencia:           p.produccion.potencia_kw,\n    rotor_rpm:          p.rotor.rpm,\n    pitch:              p.rotor.pitch_deg,\n    vibracion:          p.condicion.vibracion_mms,\n    temp_rodamiento:    p.condicion.temp_rodamiento_c,\n    temp_multiplicador: p.condicion.temp_multiplicador_c,\n    estado:             p.estado.codigo,\n    averia:             p.estado.averia_codigo,\n    // etiqueta: lo que está pasando DE VERDAD (lo fija el botón de escenario)\n    escenario:          flow.get(\"escenario\") || \"normal\"\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 100,
