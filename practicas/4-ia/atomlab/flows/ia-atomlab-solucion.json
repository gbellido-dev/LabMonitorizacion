    {
        "id": "1763cf116b874b7c",
        "type": "function",
        "z": "2b89ec73d8fc7522",
        "name": "¿Aún no se ha pulsado?",
        "func": "// ENTRADA: GET /api/v1/medidas (la sala de control, cada segundo)\n// SALIDA:  la misma fila (las entradas del modelo tienen los mismos nombres que en el lote)\n\nconst m = msg.payload;\nif (m.proteccion_danado || m.proteccion_scram) {\n    node.status({ fill: \"grey\", shape: \"ring\", text: m.proteccion_danado ? \"central dañada\" : \"SCRAM: ya se pulsó\" });\n    return null;                                   // el modelo responde a «¿y si lo pulso AHORA?»\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
