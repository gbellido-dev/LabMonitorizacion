    {
        "id": "18cf5de322975d88",
        "type": "function",
        "z": "2b89ec73d8fc7522",
        "name": "Riesgo",
        "func": "// ENTRADA: las medidas + msg.prediccion = { clase, probabilidad } del modelo atomlab-az5\n// SALIDA:  telemetría para ThingsBoard\n\nconst m = msg.payload, r = msg.prediccion;\nconst riesgo = r.clase === 1 ? r.probabilidad : 1 - r.probabilidad;     // probabilidad de rotura de canales\nflow.set(\"riesgo_modelo\", riesgo);\nnode.status({ fill: riesgo >= 0.5 ? \"red\" : \"green\", shape: \"dot\", text: `riesgo AZ-5 ${(100 * riesgo).toFixed(0)} %` });\nmsg.payload = { ts: Date.now(), values: {\n    potencia_mwt: m.reactor_potencia_mwt, orm: m.reactor_orm_barras, xenon: m.reactor_xenon_rel,\n    vacio_pct: m.reactor_vacio_pct, reactividad_beta: m.reactor_reactividad_beta,\n    riesgo_az5_pct: Math.round(1000 * riesgo) / 10, az5_peligroso: riesgo >= 0.5,\n    orm_bajo: m.reactor_orm_barras < 15           // la regla del reglamento del RBMK\n} };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
