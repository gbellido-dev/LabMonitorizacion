    {
        "id": "855ea07f4eba5c38",
        "type": "function",
        "z": "2b89ec73d8fc7522",
        "name": "Filas",
        "func": "// ENTRADA: la respuesta del lote { casos: [ { escenario, medidas, az5_pico_mwt, az5_pico_rel, az5_danado } ] }\n// SALIDA:  msg.payload = una lista de filas planas para el conjunto \"atomlab-az5\"\n\nconst r = msg.payload;\nmsg.payload = r.casos.map(c => ({\n    ...c.medidas,                                  // lo que se veía en la sala de control antes del AZ-5\n    // la etiqueta: lo que pasó al pulsar el AZ-5\n    az5_pico_rel: c.az5_pico_rel,                  // pico de potencia / potencia antes del AZ-5\n    az5_danado: c.az5_danado ? 1 : 0               // rotura de canales\n}));\nconst n = msg.payload.filter(f => f.az5_danado).length;\nnode.status({ fill: \"green\", shape: \"dot\", text: `${r.casos.length} casos en ${r.segundos_cpu} s · ${n} explosiones` });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 120,
        "wires": [
