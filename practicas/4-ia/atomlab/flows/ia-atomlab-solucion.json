    {
        "id": "df22aaabd4dac24b",
        "type": "function",
        "z": "2b89ec73d8fc7522",
        "name": "Lote de simulaciones",
        "func": "// ENTRADA: el número de casos (botón)\n// SALIDA:  POST /api/v1/simulacion/lote: AtomLab inventa estados de operación al azar y pulsa el AZ-5 en cada uno\n// No toca la central de la sala de control: cada caso es una central nueva. 500 casos tardan unos 20 s.\n\nconst lotes = (flow.get(\"lotes\") || 0) + 1;\nflow.set(\"lotes\", lotes);\nmsg.method = \"POST\";\nmsg.url = \"http://atomlab:8040/api/v1/simulacion/lote\";\nmsg.headers = { \"Content-Type\": \"application/json\" };\nmsg.payload = { casos: Number(msg.payload), semilla: lotes };     // otra semilla en cada lote: casos distintos\nmsg.requestTimeout = 120000;\nnode.status({ fill: \"yellow\", shape: \"ring\", text: `lote ${lotes}: simulando ${msg.payload.casos} casos…` });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 120,
        "wires": [
            [
                "5ba5e2a37d0879e2"
            ]
        ]
    },
    {
        "id": "5ba5e2a37d0879e2",
        "type": "http request",
        "z": "2b89ec73d8fc7522",
        "name": "POST simulacion/lote",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 540,
        "y": 120,
