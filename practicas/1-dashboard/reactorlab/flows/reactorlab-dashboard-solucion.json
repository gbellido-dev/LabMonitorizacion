    {
        "id": "416561290f9697c3",
        "type": "function",
        "z": "9fff18c5b8ffb5cc",
        "name": "Alarma presión",
        "func": "// ENTRADA: el estado de la planta (msg.payload)\n// SALIDA:  msg.payload = \"NORMAL\" o \"ALARMA\"\n\nconst LIMITE_PRESION = 2850;   // kPa. Puedes cambiar este valor.\n\nconst presion = msg.payload.medidas.presion_kpa;\n\nif (presion > LIMITE_PRESION) {\n    msg.payload = \"ALARMA\";\n} else {\n    msg.payload = \"NORMAL\";\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
        "y": 780,
