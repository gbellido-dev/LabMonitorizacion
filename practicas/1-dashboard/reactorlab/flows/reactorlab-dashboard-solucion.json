    {
        "id": "7dc3e51f57d200b9",
        "type": "function",
        "z": "9fff18c5b8ffb5cc",
        "name": "Comprobar respuesta",
        "func": "// ENTRADA: la respuesta de ReactorLab (por HTTP o, más adelante, por WebSocket)\n//   msg.statusCode = código HTTP (200 = correcto). Por WebSocket no existe.\n//   msg.payload    = el estado de la planta en JSON\n// SALIDA:  el mismo mensaje, solo si la respuesta es correcta\n\nif (msg.statusCode !== undefined && msg.statusCode !== 200) {\n    node.status({ fill: \"red\", shape: \"dot\", text: \"HTTP \" + msg.statusCode });\n    return null;                          // 404, 500, ECONNREFUSED... no seguimos\n}\nif (typeof msg.payload !== \"object\" || !msg.payload.medidas) {\n    node.status({ fill: \"red\", shape: \"ring\", text: \"respuesta no válida\" });\n    return null;\n}\nnode.status({ fill: \"green\", shape: \"dot\", text: \"secuencia \" + msg.payload.secuencia });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 100,
        "wires": [
