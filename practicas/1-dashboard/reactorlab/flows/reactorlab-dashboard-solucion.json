    {
        "id": "ef6a1d0ee4d2c903",
        "type": "ui-template",
        "z": "9fff18c5b8ffb5cc",
        "name": "",
        "order": 1,
        "width": "0",
        "height": "0",
        "head": "",
        "noerr": 0,
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "group": "f17f9011d1107fc7",
        "format": "<template>\n  <div :style=\"{ background: color, color: 'white', padding: '12px',\n                 textAlign: 'center', fontSize: '1.6em',\n                 fontWeight: 'bold', borderRadius: '8px' }\">\n    {{ msg?.payload || 'SIN DATOS' }}\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    color() {\n      const colores = { 'NORMAL': '#2e7d32', 'ATENCIÓN': '#f9a825', 'ALARMA': '#c62828' };\n      return colores[this.msg?.payload] || '#757575';\n    }\n  }\n}\n</script>",
        "x": 1000,
