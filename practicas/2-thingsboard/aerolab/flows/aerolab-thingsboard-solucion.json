    {
        "id": "126b406b3ce0399c",
        "type": "function",
        "z": "0e818bb2030e9e24",
        "name": "Señales",
        "func": "// ENTRADA: los 5 discrete inputs (true / false)\n// SALIDA:  msg.payload = las señales con nombre (ThingsBoard pone la hora)\n\nconst s = msg.payload;\nif (!Array.isArray(s) || s.length < 5) {\n    return null;\n}\nmsg.payload = {\n    preparado:     s[0],\n    en_marcha:     s[1],\n    alarma:        s[2],\n    conectado_red: s[3],\n    viento_valido: s[4]\n};\nreturn msg;",
        "outputs": 1,
