    {
        "id": "cb08c5fd4671d814",
        "type": "function",
        "z": "0e818bb2030e9e24",
        "name": "Consignas",
        "func": "// ENTRADA: los 8 holding registers (consignas guardadas en la máquina)\n// SALIDA:  msg.payload = las consignas que interesan en ThingsBoard\n\nconst h = msg.payload;\nif (!Array.isArray(h) || h.length < 8) {\n    return null;\n}\nmsg.payload = {\n    limite_kw:        h[4],\n    averia_inyectada: h[5]\n};\nreturn msg;",
