    {
        "id": "84bcb7aafc6195bf",
        "type": "function",
        "z": "2173e4b0f243d6a0",
        "name": "Guardar OPC UA",
        "func": "// ENTRADA: un mensaje por señal OPC UA (msg.topic = NodeId)\n// SALIDA:  nada; guarda el valor para compararlo\n\nif (!String(msg.topic).startsWith(\"ns=\")) return null;\nlet v = msg.payload;\nwhile (v !== null && typeof v === \"object\" && \"value\" in v) v = v.value;\nconst opc = flow.get(\"opcua\") || {};\nopc[String(msg.topic).split(\"s=\").pop()] = { v, t: Date.now() };\nflow.set(\"opcua\", opc);\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
        "y": 100,
        "wires": [
            []
        ]
    },
