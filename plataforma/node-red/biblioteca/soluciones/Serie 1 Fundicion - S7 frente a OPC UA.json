    {
        "id": "8db5acb2fef4185a",
        "type": "function",
        "z": "2173e4b0f243d6a0",
        "name": "Suscribir por OPC UA",
        "func": "// ENTRADA: el inject \"Iniciar\"\n// SALIDA:  las mismas señales por OPC UA (en las carpetas TagsS7 de cada activo)\n\nconst SENALES = [\n    [\"IF01_Temp\", \"DB10,REAL0\", \"IF-01.TagsS7.Metal.Temp\", \"Double\"],\n    [\"IF01_Listo\", \"DB11,X12.0\", \"IF-01.TagsS7.ReadyToPour\", \"Boolean\"],\n    [\"Cuchara_kg\", \"DB30,REAL0\", \"COL-01.TagsS7.Ladle.Weight\", \"Double\"],\n    [\"Colada_C\", \"DB30,REAL8\", \"COL-01.TagsS7.Pour.Temp\", \"Double\"],\n    [\"IF02_Alarmas\", \"DB90,WORD4\", \"IF-02.TagsS7.Alarm.Word\", \"UInt16\"],\n    [\"Defecto_QC\", \"DB61,WORD0\", \"QC-01.TagsS7.Defect.Class\", \"UInt16\"]\n];\nnode.status({ text: SENALES.length + \" señales\" });\nreturn [SENALES.map(([nombre, s7, nodo, tipo]) => ({ topic: \"ns=1;s=\" + nodo, datatype: tipo, nombre }))];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 100,
        "wires": [
            [
                "19391c3ee83b6bc8"
            ]
        ]
    },
