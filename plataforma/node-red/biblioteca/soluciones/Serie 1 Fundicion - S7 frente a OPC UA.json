    {
        "id": "48d8c8246c4d2e9a",
        "type": "function",
        "z": "2173e4b0f243d6a0",
        "name": "Decodificar los bytes",
        "func": "// ENTRADA: los 4 bytes en bruto de DB10.DBD0 (msg.payload.IF01_bytes = [68, 184, 153, 154])\n// SALIDA:  el REAL decodificado a mano (IEEE 754, big-endian), igual que hace el nodo S7\n\nconst b = msg.payload.IF01_bytes;\nif (!Array.isArray(b) && !(b instanceof Buffer)) return null;\nconst buf = Buffer.from(b);\nmsg.payload = {\n    bytes: Array.from(buf).map(x => x.toString(16).padStart(2, \"0\")).join(\" \"),\n    real: buf.readFloatBE(0),              // así lo guarda un S7: el byte más significativo primero\n    si_fuera_little_endian: buf.readFloatLE(0)\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 280,
        "wires": [
            [
                "5c0e096f8b6e226a"
            ]
        ]
    },
