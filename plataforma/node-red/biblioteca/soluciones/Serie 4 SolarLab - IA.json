        "name": "Campaña de irradiancia",
        "func": "// ENTRADA: un pulso cada 30 s\n// SALIDA:  una irradiancia nueva (escritura OPC UA)\n\nconst g = Math.round(100 + Math.random() * 1000);   // 100-1100 W/m²\nnode.status({ text: g + \" W/m²\" });\nreturn { topic: \"ns=2;s=Controls.IrradianceSetpoint\", datatype: \"Double\", payload: g };",
