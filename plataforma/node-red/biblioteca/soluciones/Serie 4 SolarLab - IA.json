    {
        "id": "d7d6f2293c411073",
        "type": "function",
        "z": "0c39bed0900b5029",
        "name": "Fila plana",
        "func": "// ENTRADA: el parque agrupado (bloques Plant y Controls)\n// SALIDA:  msg.payload = una fila plana para el conjunto \"solarlab\"\n\nconst pl = msg.payload.Plant || {};\nconst c  = msg.payload.Controls || {};\nif (pl.ActivePower === undefined || pl.Irradiance === undefined) {\n    return null;                                   // aún no han llegado las variables básicas\n}\nmsg.payload = {\n    irradiancia:   pl.Irradiance,\n    temp_panel:    pl.PanelTemperature,\n    temp_ambiente: pl.AmbientTemperature,\n    potencia:      pl.ActivePower,\n    pr:            pl.PerformanceRatio,\n    averia:        c.FaultCode ?? 0                // etiqueta: la avería inyectada\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1230,
        "y": 200,
        "wires": [
