    {
        "id": "2d450e896dcbdf12",
        "type": "function",
        "z": "0c39bed0900b5029",
        "name": "Agrupar",
        "func": "// ENTRADA: un mensaje por variable (msg.topic = NodeId, msg.payload = valor)\n// SALIDA:  msg.payload = todas las variables recibidas, agrupadas por bloque\n\nlet valor = msg.payload;\n// algunas versiones envían el valor dentro de { value: ... }\nwhile (valor !== null && typeof valor === \"object\" && \"value\" in valor) {\n    valor = valor.value;\n}\nif (typeof valor === \"number\") {\n    valor = Math.round(valor * 100) / 100;       // 2 decimales\n}\n\n// \"ns=2;s=Plant.ActivePower\"  →  bloque \"Plant\", variable \"ActivePower\"\nconst nombre = String(msg.topic).split(\"s=\").pop();\nconst [bloque, variable] = nombre.split(\".\");\n\nconst parque = flow.get(\"parque\") || {};\nparque[bloque] = parque[bloque] || {};\nparque[bloque][variable] = valor;\nparque.timestamp = new Date().toISOString();\nflow.set(\"parque\", parque);\n\nmsg.payload = parque;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 920,
        "y": 200,
        "wires": [
            [
                "e1668fa2110cde0a"
            ]
        ]
    },
    {
        "id": "e1668fa2110cde0a",
        "type": "delay",
        "z": "0c39bed0900b5029",
        "name": "1 fila/s",
        "pauseType": "rate",
        "timeout": "5",
        "timeoutUnits": "seconds",
        "rate": "1",
        "nbRateUnits": "1",
        "rateUnits": "second",
        "randomFirst": "1",
        "randomLast": "5",
        "randomUnits": "seconds",
        "drop": true,
        "allowrate": false,
