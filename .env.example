# Copia este archivo como .env para cambiar la configuración del entorno.

# Nombre o IP con que los clientes externos (UAExpert, otro PC del aula)
# alcanzan este equipo. Se anuncia en los endpoints OPC UA.
LAB_PUBLIC_HOST=localhost

# true = la biblioteca de Node-RED incluye los flujos resueltos (profesorado)
NODE_RED_INCLUIR_SOLUCIONES=false

# Contraseña de la base de datos de ThingsBoard
TB_DB_PASSWORD=postgres
